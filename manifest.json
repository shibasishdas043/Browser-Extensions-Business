{
  "manifest_version": 3,
  "name": "ZenWeb - Digital Peace Suite",
  "version": "1.0.0",
  "description": "Clean up the web: skip recipe fluff, kill floating videos, block Pinterest spam, smash overlays, and save form text.",
  "icons": {
    "16": "assets/16x16.png",
    "32": "assets/32x32.png",
    "48": "assets/48x48.png",
    "128": "assets/128x128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ZenWeb - Digital Peace",
    "default_icon": {
      "16": "assets/16x16.png",
      "32": "assets/32x32.png",
      "48": "assets/48x48.png",
      "128": "assets/128x128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "windows": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z",
        "linux": "Alt+Shift+Z",
        "chromeos": "Alt+Shift+Z"
      },
      "description": "Open ZenWeb Quick Action Popup"
    },
    "smash-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "windows": "Alt+Shift+X",
        "mac": "Alt+Shift+X",
        "linux": "Alt+Shift+X",
        "chromeos": "Alt+Shift+X"
      },
      "description": "Panic Trigger: Smash Overlays & Restore Page Scroll"
    },
    "jump-recipe": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "windows": "Alt+Shift+J",
        "mac": "Alt+Shift+J",
        "linux": "Alt+Shift+J",
        "chromeos": "Alt+Shift+J"
      },
      "description": "Quick View: Extract & Jump to Recipe"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

